{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "clean": "rm -rf .turbo node_modules .cache dist",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/prettier": "workspace:*",
    "@repo/typescript": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "catalog:"
  }
}
