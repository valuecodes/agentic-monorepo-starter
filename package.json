{
  "name": "agentic-monorepo-starter",
  "description": "Monorepo template for agent-assisted development",
  "private": true,
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "secrets:scan": "sh tooling/github/scripts/secrets-scan.sh",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
